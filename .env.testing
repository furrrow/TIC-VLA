# TIC-VLA DynaNav / Isaac Sim testing — edit paths for your machine
export ISAAC_SIM_ROOT="${HOME}/isaacsim"
export ISAAC_SIM_PYTHON="${ISAAC_SIM_ROOT}/python.sh"
export ROS_DISTRO=humble
export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

# Isaac Sim ROS 2 Humble bridge libraries
export LD_LIBRARY_PATH="${LD_LIBRARY_PATH}:${ISAAC_SIM_ROOT}/exts/isaacsim.ros2.bridge/humble/lib"

export ROS_DOMAIN_ID=42

export TICVLA_DYNANAV_ROOT="$(pwd)/DynaNav"
export TICVLA_BASE_MODEL_PATH="$(pwd)/models/InternVL3-1B"
export TICVLA_CHECKPOINT_PATH="$(pwd)/models/TIC-VLA-model.ckpt"
export TICVLA_OUTPUT_DIR=outputs

# Machine-specific storage path; override this on other machines if needed
export TICVLA_LOG_DIR="/media/${USER}/HardDisk/TIC-VLA-Logs"

# Pick ISAAC_SIM_ASSETS_ROOT: local assets or ones online
# export ISAAC_SIM_ASSETS_ROOT="/media/${USER}/HardDisk/isaacsim_assets"
export ISAAC_SIM_ASSETS_ROOT="https://omniverse-content-production.s3-us-west-2.amazonaws.com"

export DEFAULT_CHARACTER_ASSET_PATH="${ISAAC_SIM_ASSETS_ROOT}/Assets/Isaac/5.1/Isaac/People/Characters/"
export DEFAULT_BIPED_ASSET_PATH="${ISAAC_SIM_ASSETS_ROOT}/Assets/Isaac/5.1/Isaac/People/Characters/Biped_Setup.usd"
export HOSPITAL_USD_PATH="${ISAAC_SIM_ASSETS_ROOT}/Assets/Isaac/5.1/Isaac/Environments/Hospital/hospital.usd"
export WAREHOUSE_USD_PATH="${ISAAC_SIM_ASSETS_ROOT}/Assets/Isaac/5.1/Isaac/Environments/Simple_Warehouse/full_warehouse.usd"