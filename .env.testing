# TIC-VLA DynaNav / Isaac Sim testing — edit paths for your machine
export ISAAC_SIM_ROOT=~/isaacsim
export ISAAC_SIM_PYTHON="${ISAAC_SIM_ROOT}/python.sh"
export TICVLA_DYNANAV_ROOT="$(pwd)/DynaNav"
export TICVLA_BASE_MODEL_PATH=$(pwd)/models/InternVL3-1B
export TICVLA_CHECKPOINT_PATH=$(pwd)/models/TIC-VLA-model.ckpt
export TICVLA_OUTPUT_DIR=outputs
export TICVLA_VIEWPORT_CAMERA=third_person  # third_person, front, none
export TICVLA_LOG_DIR="/media/jim/HardDisk/TIC-VLA-Logs"
# pick ISAAC_SIM_ASSETS_ROOT, local assets or ones from online:
export ISAAC_SIM_ASSETS_ROOT=/media/jim/HardDisk/isaacsim_assets
#export ISAAC_SIM_ASSETS_ROOT=https://omniverse-content-production.s3-us-west-2.amazonaws.com

export DEFAULT_CHARACTER_ASSET_PATH="${ISAAC_SIM_ASSETS_ROOT}/Assets/Isaac/5.1/Isaac/People/Characters/"
export DEFAULT_BIPED_ASSET_PATH="${ISAAC_SIM_ASSETS_ROOT}/Assets/Isaac/5.1/Isaac/People/Characters/Biped_Setup.usd"
export HOSPITAL_USD_PATH="${ISAAC_SIM_ASSETS_ROOT}/assets/hospital.usd"
export WAREHOUSE_USD_PATH="${ISAAC_SIM_ASSETS_ROOT}/assets/full_warehouse.usd"